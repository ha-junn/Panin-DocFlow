# Supabase Project URL dari Project Settings > API.
# Contoh benar: https://your-project-ref.supabase.co
# Jangan gunakan URL yang berakhiran /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key / publishable key.
# Jangan isi dengan secret key atau service role key.
# Key ini aman dipakai di frontend hanya jika Row Level Security aktif.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
